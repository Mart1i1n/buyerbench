</footer>

<!-- ═══════ ALL JAVASCRIPT ═══════ -->
<script>
/* ── Go Home ── */
function goHome() {
  input.value = ''; lastQuery = ''; hideAc(); acItems = [];
  document.querySelectorAll('.detail-panel').forEach(p => p.remove());
  document.querySelectorAll('.detail-overlay').forEach(p => p.remove());
  hero.classList.remove('compact');
  mainContent.style.display = '';
  resultsContainer.classList.remove('visible');
  document.getElementById('filters').style.display = 'none';
  history.pushState({}, '', location.pathname);
}

/* ── Globals ── */
const input = document.getElementById('searchInput');
const ac = document.getElementById('autocomplete');
const hero = document.getElementById('hero');
const mainContent = document.getElementById('mainContent');
const resultsContainer = document.getElementById('results');
const resultsList = document.getElementById('resultsList');
const resultsCount = document.getElementById('resultsCount');
const statsLine = document.getElementById('statsLine');
let activeType = '';
let acIndex = -1;
let debounceTimer = null;
let lastQuery = '';
let acItems = [];
let isPushSearch = false;
let suppressAc = false;

/* ── Formatting ── */
function fmtUsd(n) {
  if (n >= 1e6) return '$' + (n / 1e6).toFixed(0) + 'M';
  if (n >= 1e3) return '$' + (n / 1e3).toFixed(0) + 'K';
  if (n >= 1) return '$' + n.toFixed(0);
  return '$' + n.toFixed(2);
}
function formatCompact(n) {
  if (n >= 1e9) return '$' + (n / 1e9).toFixed(2) + 'B';
  if (n >= 1e6) return '$' + (n / 1e6).toFixed(2) + 'M';
  if (n >= 1e3) return '$' + (n / 1e3).toFixed(2) + 'K';
  return '$' + n.toFixed(2);
}
function formatNum(n) {
  if (n >= 1e9) return (n / 1e9).toFixed(2) + 'B';
  if (n >= 1e6) return (n / 1e6).toFixed(2) + 'M';
  if (n >= 100000) return (n / 1e3).toFixed(1) + 'K';
  return n.toLocaleString();
}
function esc(s) { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }
function setUrlParam(k, v) { const p = new URLSearchParams(location.search); p.set(k, v); return '?' + p.toString(); }
function removeUrlParam(k) { const p = new URLSearchParams(location.search); p.delete(k); const s = p.toString(); return s ? '?' + s : location.pathname; }

/* ── Animated counters ── */
function animateValue(el, target, dur, compact) {
  if (!el) return;
  if (dur === 0) { el.textContent = compact ? formatNum(target) : target.toLocaleString(); el._val = target; return; }
  const start = el._val || 0; el._val = target;
  if (start === target) return;
  const t0 = performance.now();
  function step(now) {
    const p = Math.min((now - t0) / dur, 1);
    const e = 1 - Math.pow(1 - p, 3);
    el.textContent = compact ? formatNum(Math.round(start + (target - start) * e)) : Math.round(start + (target - start) * e).toLocaleString();
    if (p < 1) requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}
function animateCurrency(el, target, dur) {
  if (!el) return;
  if (dur === 0) { el.textContent = formatCompact(target); el._val = target; return; }
  const start = el._val || 0; el._val = target;
  if (start === target) return;
  const t0 = performance.now();
  function step(now) {
    const p = Math.min((now - t0) / dur, 1);
    const e = 1 - Math.pow(1 - p, 3);
    el.textContent = formatCompact(start + (target - start) * e);
    if (p < 1) requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}

/* ── Category labels ── */
const CAT_LABELS = {
  "database":"Databases","version-control":"Version Control","filesystem":"File Systems",
  "auth":"Identity & Auth","crypto":"Blockchain & Web3","finance":"Finance & Fintech",
  "marketing":"Marketing & Ads","commerce":"Commerce & Payments",
  "entertainment":"Entertainment & Gaming","search":"Search & Extraction",
  "ai-ml":"AI & Machine Learning","developer-tools":"Developer Tools",
  "infrastructure":"Infrastructure","cloud":"Cloud Platforms",
  "observability":"Monitoring & Analytics","api-integration":"API Integration",
  "communication":"Communication","media":"Multimedia & Design",
  "content":"Content & Publishing","social":"Social Media",
  "geo":"Location & Weather","research":"Research & Science",
  "education":"Education","compliance":"Security & Compliance",
  "iot":"IoT & Hardware","data":"Data Processing",
  "productivity":"Productivity & PM","other":"Other",
};
function catLabel(id) { return CAT_LABELS[id] || id; }

/* ── Render bar charts ── */
function renderBars(containerId, items, getLabel, getValue, barColor, isCurrency) {
  const c = document.getElementById(containerId);
  if (!items || !items.length) { c.innerHTML = '<div class="bar-row"><span class="bar-label" style="color:var(--text-dim)">Loading...</span></div>'; return; }
  const max = getValue(items[0]);
  c.innerHTML = items.slice(0, 10).map(item => {
    const v = getValue(item);
    const display = isCurrency
      ? (typeof v === 'number' && v > 100 ? formatCompact(v) : '$' + v.toLocaleString())
      : (typeof v === 'number' && v > 100 ? formatNum(v) : v.toLocaleString());
    return `
    <div class="bar-row">
      <span class="bar-label">${esc(getLabel(item))}</span>
      <div class="bar-track"><div class="bar-fill" style="width:0%;${barColor ? 'background:'+barColor : ''}" data-width="${(getValue(item)/max*100).toFixed(1)}%"></div></div>
      <span class="bar-count">${display}</span>
    </div>
  `}).join('');
  requestAnimationFrame(() => { c.querySelectorAll('.bar-fill').forEach(b => { b.style.width = b.dataset.width; }); });
}

/* ── Category pills ── */
const CATEGORIES = ['crypto','finance','ai-ml','developer-tools','commerce','data','search','infrastructure','cloud','media','communication','social','entertainment','education','research','compliance','geo','marketing','productivity','iot'];
document.getElementById('catPills').innerHTML = CATEGORIES.map(c =>
  `<a class="cat-pill" href="javascript:void(0)" onclick="input.value='';activeType='';input.value=catLabel('${c}');isPushSearch=true;lastQuery='';suppressAc=true;hideAc();fullSearch();window.scrollTo(0,0)">${catLabel(c)}</a>`
).join('');

/* ── Branding per domain ── */
fetch('/api/brand').then(r => r.json()).then(b => {
  document.getElementById('heroTagline').textContent = b.tagline;
  document.title = b.logo + ' — ' + b.tagline;
  if (b.defaultType) {
    activeType = b.defaultType;
    document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.toggle('active', btn.dataset.type === b.defaultType));
  }
  if (b.defaultCategory) window._defaultCategory = b.defaultCategory;
}).catch(() => {}).then(() => {
  const params = new URLSearchParams(location.search);
  const initActive = params.get('active');
  const initQ = params.get('search');
  if (initActive) loadActiveParam(initActive);
  else if (initQ) { input.value = initQ; fullSearch(); }
});

/* ── Back/forward ── */
window.addEventListener('popstate', () => {
  const params = new URLSearchParams(location.search);
  const active = params.get('active');
  const q = params.get('search');
  if (active) { loadActiveParam(active); }
  else if (q) { input.value = q; lastQuery = ''; document.querySelectorAll('.detail-panel').forEach(p => p.remove()); liveSearch(); }
  else { input.value = ''; lastQuery = ''; hideAc(); acItems = []; document.querySelectorAll('.detail-panel').forEach(p => p.remove()); hero.classList.remove('compact'); mainContent.style.display = ''; resultsContainer.classList.remove('visible'); document.getElementById('filters').style.display = 'none'; }
});

/* ── Load feeds ── */
fetch('/api/feeds').then(r => r.json()).then(f => {
  statsLine.innerHTML = `<span>${f.totalServices.toLocaleString()}</span> services &middot; <span>${fmtUsd(f.totalVolume)}</span> tracked across x402, MCP, and MPP`;
  renderFeed('gridTopEarners', f.topEarners);
  renderFeed('gridTrending', f.trending);
  renderFeed('gridRising', f.rising);
  renderFeed('gridHidden', f.hidden);
}).catch(() => {
  fetch('/api/stats').then(r => r.json()).then(s => {
    statsLine.innerHTML = `<span>${s.totalServices.toLocaleString()}</span> services &middot; <span>${fmtUsd(s.totalVolume)}</span> tracked across x402, MCP, and MPP`;
  }).catch(() => {});
});

function renderFeed(gridId, items) {
  const grid = document.getElementById(gridId);
  if (!items || !items.length) { grid.closest('.feed-row').style.display = 'none'; return; }
  grid.innerHTML = items.map(r => `
    <div class="feed-card" data-domain="${esc(r.name)}" onclick="openDetailOverlay('${esc(r.name)}')">
      <div class="fc-name">${esc(r.name)}</div>
      ${r.description ? `<div class="fc-desc">${esc(r.description.slice(0,100))}</div>` : ''}
      <div class="fc-meta">
        <span class="fc-tag ${r.type}">${r.type}</span>
        <span class="fc-tag">${esc(r.category)}</span>
        ${r.revenue ? `<span class="fc-tag rev">${fmtUsd(r.revenue)}</span>` : ''}
        ${r.score ? `<span class="fc-tag">score ${r.score}</span>` : ''}
      </div>
    </div>
  `).join('');
}

/* ── Period selector & dashboard data ── */
let currentPeriod = 'all';
let allTimeData = null;
const tsCache = {}; // client-side cache: { '7d': {data, ts}, '30d': ... }
const TS_CACHE_TTL = 60000; // 60s

// Period selector click handler
document.getElementById('periodSelector').addEventListener('click', (e) => {
  const btn = e.target.closest('.period-btn');
  if (!btn || btn.classList.contains('active')) return;
  document.querySelectorAll('.period-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  currentPeriod = btn.dataset.period;
  loadDashboardData(currentPeriod);
});

// Normalize timeseries response
function normalizeTimeseries(ts) {
  const s = ts.summary || {};
  return {
    totalVolume: s.volume || 0,
    totalPayments: s.payments || 0,
    uniqueEarners: s.uniqueEarners || 0,
    topEarners: ts.topEarners || [],
    x402Categories: (ts.categoryRevenue || []).map(c => ({
      category: c.category, count: c.earners || 0, revenue: c.revenue || 0
    })),
    lastIndexed: ts.generatedAt,
  };
}

// Load all-time data — populates constant sections + serves as instant fallback
async function loadAllTimeBaseline() {
  try {
    const res = await fetch('/api/intelligence-stats');
    if (!res.ok) return;
    allTimeData = await res.json();
    const d = allTimeData;

    // MCP categories — constant
    renderBars('mcpCatBars', d.categories || [], c => catLabel(c.category), c => c.count, 'var(--accent)', false);

    // Score buckets — constant
    const sd = d.scoreDistribution || {};
    document.getElementById('bk-exc').textContent = (sd.excellent || 0).toLocaleString();
    document.getElementById('bk-good').textContent = (sd.good || 0).toLocaleString();
    document.getElementById('bk-avg').textContent = (sd.average || 0).toLocaleString();
    document.getElementById('bk-low').textContent = (sd.below || 0).toLocaleString();

    // System status constants
    document.getElementById('st-x402').textContent = (d.totalX402Services || 0).toLocaleString();
    const totalScored = (sd.excellent||0)+(sd.good||0)+(sd.average||0)+(sd.below||0);
    document.getElementById('st-scored').textContent = totalScored.toLocaleString();

    // Hero constants
    animateValue(document.getElementById('stat-x402'), d.totalX402Services || 0, 1500);
    animateValue(document.getElementById('stat-mcp'), d.totalMcpServers || 0, 1500);

    // On boot (default=all), this IS the period data too
    updatePeriodData(d, 1200);
  } catch (_) {}
}

// Load period-scoped data
async function loadDashboardData(period) {
  // Instant: show cached data if we have it
  const cached = tsCache[period];
  if (cached && (Date.now() - cached.ts) < TS_CACHE_TTL) {
    updatePeriodData(cached.data, 400);
    return;
  }

  // For "all", use allTimeData if already loaded
  if (period === 'all' && allTimeData) {
    updatePeriodData(allTimeData, 400);
    return;
  }

  document.querySelectorAll('.period-btn').forEach(b => b.classList.add('loading'));

  let data = null;

  if (period !== 'all') {
    try {
      const res = await fetch('/api/intelligence-stats/timeseries?period=' + period);
      if (res.ok) {
        const ts = await res.json();
        if (ts && ts.topEarners) {
          data = normalizeTimeseries(ts);
          tsCache[period] = { data, ts: Date.now() };
        }
      }
    } catch (_) {}
  }

  // Fallback
  if (!data) {
    if (allTimeData) {
      data = allTimeData;
    } else {
      try {
        const res = await fetch('/api/intelligence-stats');
        if (res.ok) data = await res.json();
      } catch (_) {}
    }
  }

  if (data) updatePeriodData(data, 600);

  document.querySelectorAll('.period-btn').forEach(b => b.classList.remove('loading'));
}

// Only update sections that change by period
function updatePeriodData(d, dur) {
  animateCurrency(document.getElementById('stat-volume'), d.totalVolume || 0, dur);
  animateValue(document.getElementById('stat-payments'), d.totalPayments || 0, dur, true);

  renderBars('earnerBars', d.topEarners, e => e.domain, e => e.revenue, 'var(--accent2)', true);

  const catData = (d.x402Categories || []).sort((a,b) => (b.revenue || b.count || 0) - (a.revenue || a.count || 0)).slice(0,10);
  const catHasRevenue = catData.length > 0 && catData[0].revenue > 0;
  renderBars('x402CatBars', catData, c => catLabel(c.category), c => catHasRevenue ? c.revenue : c.count, 'var(--accent2)', catHasRevenue);

  document.getElementById('st-vol').textContent = formatCompact(d.totalVolume || 0);
  document.getElementById('st-pay').textContent = (d.totalPayments || 0).toLocaleString();
  const pct = d.uniqueEarners ? Math.round((d.uniqueEarners / 98327) * 100) : 0;
  document.getElementById('st-earn').textContent = pct + '%';
  document.getElementById('st-updated').textContent = d.lastIndexed ? new Date(d.lastIndexed).toLocaleString() : 'Indexing...';
}

// Prefetch a timeseries period into cache silently
async function prefetchPeriod(period) {
  if (tsCache[period]) return;
  try {
    const res = await fetch('/api/intelligence-stats/timeseries?period=' + period);
    if (res.ok) {
      const ts = await res.json();
      if (ts && ts.topEarners) tsCache[period] = { data: normalizeTimeseries(ts), ts: Date.now() };
    }
  } catch (_) {}
}

// Boot: load all-time baseline, then prefetch 7d + 30d in background
loadAllTimeBaseline().then(() => {
  prefetchPeriod('30d');
  prefetchPeriod('7d');
});

/* ── MPP stats from local /api/stats ── */
fetch('/api/stats').then(r => r.ok ? r.json() : Promise.reject()).then(s => {
  animateValue(document.getElementById('stat-mpp'), s.totalMpp || 0, 1500);
}).catch(() => {});

/* ── Filters ── */
let lastActiveType = '';
document.getElementById('filters').addEventListener('click', (e) => {
  const b = e.target.closest('.filter-btn');
  if (!b) return;
  document.querySelectorAll('.filter-btn').forEach(x => x.classList.remove('active'));
  b.classList.add('active');
  activeType = b.dataset.type;
  if (input.value.trim()) { lastQuery = ''; liveSearch(); }
});

/* ── Autocomplete ── */
input.addEventListener('input', () => { clearTimeout(debounceTimer); debounceTimer = setTimeout(liveSearch, 100); });
input.addEventListener('focus', () => { if (input.value.trim() && acItems.length) showAc(); });
input.addEventListener('keydown', (e) => {
  const visible = ac.classList.contains('visible');
  if (e.key === 'ArrowDown') { e.preventDefault(); if (!visible && acItems.length) { showAc(); return; } acIndex = Math.min(acIndex + 1, acItems.length - 1); highlightAc(); }
  else if (e.key === 'ArrowUp') { e.preventDefault(); acIndex = Math.max(acIndex - 1, -1); highlightAc(); }
  else if (e.key === 'Enter') { e.preventDefault(); hideAc(); suppressAc = true; fullSearch(); }
  else if (e.key === 'Escape') hideAc();
});
document.addEventListener('click', (e) => { if (!document.getElementById('searchBox').contains(e.target)) hideAc(); });
document.getElementById('searchBtn').addEventListener('click', fullSearch);

function showAc() {
  if (!acItems.length) { hideAc(); return; }
  input.classList.add('has-dropdown'); ac.classList.add('visible');
  // Hide siblings that bleed through under the dropdown
  const filters = document.getElementById('filters');
  const stats = document.getElementById('statsLine');
  const heroStats = document.getElementById('heroStatsRow');
  if (filters) filters.style.visibility = 'hidden';
  if (stats) stats.style.visibility = 'hidden';
  if (heroStats) heroStats.style.visibility = 'hidden';
}
function hideAc() {
  ac.classList.remove('visible'); input.classList.remove('has-dropdown'); acIndex = -1;
  const filters = document.getElementById('filters');
  const stats = document.getElementById('statsLine');
  const heroStats = document.getElementById('heroStatsRow');
  if (filters) filters.style.visibility = '';
  if (stats) stats.style.visibility = '';
  if (heroStats) heroStats.style.visibility = '';
}
function highlightAc() { ac.querySelectorAll('.ac-item').forEach((el, i) => el.classList.toggle('selected', i === acIndex)); }

function renderAc(items) {
  const q = input.value.trim().toLowerCase();
  ac.innerHTML = items.slice(0, 8).map((r, i) => {
    let name = esc(r.name);
    if (q) { const idx = r.name.toLowerCase().indexOf(q); if (idx >= 0) name = esc(r.name.slice(0, idx)) + '<em>' + esc(r.name.slice(idx, idx + q.length)) + '</em>' + esc(r.name.slice(idx + q.length)); }
    return `<div class="ac-item" data-index="${i}">
      <span class="ac-type ${r.type}">${r.type}</span>
      <span class="ac-name">${name}</span>
      <span class="ac-cat">${esc(r.category)}</span>
      ${r.revenue ? `<span class="ac-rev">${fmtUsd(r.revenue)}</span>` : ''}
    </div>`;
  }).join('');
  ac.querySelectorAll('.ac-item').forEach(el => {
    el.addEventListener('mouseenter', () => { acIndex = parseInt(el.dataset.index); highlightAc(); });
    el.addEventListener('click', () => selectAc(items[parseInt(el.dataset.index)]));
  });
}

function selectAc(item) { input.value = item.name; hideAc(); suppressAc = true; fullSearch(); }

/* ── Search ── */
async function liveSearch() {
  const q = input.value.trim();
  if (!q) {
    hideAc(); acItems = [];
    hero.classList.remove('compact'); mainContent.style.display = ''; resultsContainer.classList.remove('visible');
    document.getElementById('filters').style.display = 'none';
    history.replaceState({}, '', location.pathname);
    return;
  }
  if (q === lastQuery) return;
  lastQuery = q;
  const searchUrl = '?search=' + encodeURIComponent(q);
  if (isPushSearch) { history.pushState({search: q}, '', searchUrl); isPushSearch = false; }
  else { history.replaceState({search: q}, '', searchUrl); }
  try {
    const params = new URLSearchParams({ q, limit: '30' });
    if (activeType) params.set('type', activeType);
    const res = await fetch('/search?' + params);
    const data = await res.json();
    if (input.value.trim() !== q) return;
    acItems = data.results;
    if (!suppressAc) { renderAc(acItems); showAc(); }
    suppressAc = false;
    hero.classList.add('compact');
    mainContent.style.display = 'none';
    resultsContainer.classList.add('visible');
    document.getElementById('filters').style.display = 'flex';
    resultsCount.textContent = `${data.total.toLocaleString()} results`;
    resultsList.innerHTML = data.results.map(r => `
      <div class="result-card" data-svc-type="${r.type}" onclick="openDetail('${esc(r.name)}', this)">
        <div class="result-card-header">
          <div class="result-name">${esc(r.name)}</div>
          <button class="share-btn" onclick="event.stopPropagation();openShareMenu('${esc(r.name)}',this,event,'${r.type}',${r.revenue||0})" title="Share">${SHARE_SVG}</button>
        </div>
        ${r.description ? `<div class="result-desc">${esc(r.description.slice(0,200))}</div>` : ''}
        <div class="result-meta">
          <span class="result-tag type-${r.type}">${r.type}</span>
          <span class="result-tag">${esc(r.category)}</span>
          ${r.revenue ? `<span class="result-tag revenue">${fmtUsd(r.revenue)} revenue</span>` : ''}
          ${r.payments ? `<span class="result-tag">${r.payments.toLocaleString()} payments</span>` : ''}
          ${r.score ? `<span class="result-tag">score ${r.score}</span>` : ''}
          ${r.price ? `<span class="result-tag">${r.price}</span>` : ''}
        </div>
      </div>
    `).join('');
  } catch (err) { console.error('Search error:', err); }
}

async function fullSearch() { hideAc(); isPushSearch = true; lastQuery = ''; await liveSearch(); }

/* ── Share Menu ── */
const SHARE_SVG = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>`;
const sharePopover = document.getElementById('sharePopover');
const shareCopyBtn = document.getElementById('shareCopyLink');
const shareXBtn = document.getElementById('shareToX');
const shareTgBtn = document.getElementById('shareToTg');
const shareNativeBtn = document.getElementById('shareNative');
let shareDomain = null, shareType = null, shareRevenue = 0;
if (navigator.share) shareNativeBtn.style.display = '';

function shareUrl() { return window.location.origin + '/?active=' + encodeURIComponent(shareDomain); }
function shareText() {
  let rev = '';
  if (shareRevenue >= 1e6) rev = ` ($${Math.floor(shareRevenue/1e6)}M+ in revenue)`;
  else if (shareRevenue >= 1e5) rev = ` ($${Math.floor(shareRevenue/1e3)}K+ in revenue)`;
  if (shareType === 'x402') return `${shareDomain}${rev} — pay-per-call API, no keys, no subscriptions. Try it instantly on Valoria`;
  if (shareType === 'mpp') return `${shareDomain}${rev} — MPP agent service on Tempo, pay-per-use for AI. Found on Valoria`;
  return `${shareDomain}${rev} — free AI tool you can plug into Claude, Cursor, or any MCP client. Found on Valoria`;
}

function openShareMenu(domain, btn, event, type, revenue) {
  event.stopPropagation();
  shareDomain = domain; shareType = type || null; shareRevenue = revenue || 0;
  shareCopyBtn.textContent = '🔗 Copy link'; shareCopyBtn.classList.remove('share-copied');
  sharePopover.style.display = 'block';
  const rect = btn.getBoundingClientRect();
  let top = rect.bottom + 4, left = rect.left;
  if (left + sharePopover.offsetWidth > window.innerWidth - 8) left = window.innerWidth - sharePopover.offsetWidth - 8;
  sharePopover.style.top = top + 'px'; sharePopover.style.left = left + 'px';
}
function closeShareMenu() { sharePopover.style.display = 'none'; }
function fallbackCopy(text) { const ta = document.createElement('textarea'); ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0'; document.body.appendChild(ta); ta.select(); document.execCommand('copy'); document.body.removeChild(ta); }

shareCopyBtn.addEventListener('click', (e) => {
  e.stopPropagation();
  const url = shareUrl();
  const done = () => { shareCopyBtn.textContent = '✓ Copied!'; shareCopyBtn.classList.add('share-copied'); setTimeout(() => { shareCopyBtn.textContent = '🔗 Copy link'; shareCopyBtn.classList.remove('share-copied'); closeShareMenu(); }, 1800); };
  if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(url).then(done).catch(() => { fallbackCopy(url); done(); });
  else { fallbackCopy(url); done(); }
});
shareXBtn.addEventListener('click', (e) => { e.stopPropagation(); window.open('https://x.com/intent/tweet?url=' + encodeURIComponent(shareUrl()) + '&text=' + encodeURIComponent(shareText()), '_blank', 'noopener'); closeShareMenu(); });
shareTgBtn.addEventListener('click', (e) => { e.stopPropagation(); window.open('https://t.me/share/url?url=' + encodeURIComponent(shareUrl()) + '&text=' + encodeURIComponent(shareText()), '_blank', 'noopener'); closeShareMenu(); });
shareNativeBtn.addEventListener('click', async (e) => { e.stopPropagation(); try { await navigator.share({ title: shareDomain + ' on Valoria', url: shareUrl() }); } catch (_) {} closeShareMenu(); });
document.addEventListener('click', (e) => { if (!sharePopover.contains(e.target)) closeShareMenu(); });
document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeShareMenu(); });

/* ── Active domain deep link ── */
async function loadActiveParam(domain) {
  input.value = domain;
  hero.classList.add('compact');
  mainContent.style.display = 'none';
  resultsContainer.classList.add('visible');
  resultsCount.textContent = '';
  resultsList.innerHTML = `<div class="result-card" data-domain="${esc(domain)}">
    <div class="result-card-header">
      <div class="result-name">${esc(domain)}</div>
      <button class="share-btn" onclick="event.stopPropagation();openShareMenu('${esc(domain)}',this,event)" title="Share">${SHARE_SVG}</button>
    </div>
  </div>`;
  const card = resultsList.querySelector('[data-domain]');
  card.onclick = () => openDetail(domain, card);
  await openDetail(domain, card, true);
}

/* ── Domain Detail Panel ── */
let openDetailEl = null;
async function openDetail(domain, el, skipPush) {
  const existing = el.querySelector('.detail-panel');
  if (existing) { existing.remove(); openDetailEl = null; history.replaceState({}, '', removeUrlParam('active')); return; }
  document.querySelectorAll('.detail-panel').forEach(p => p.remove());
  if (!skipPush) history.pushState({active: domain}, '', setUrlParam('active', domain));
  const panel = document.createElement('div');
  panel.className = 'detail-panel visible';
  panel.innerHTML = '<div class="detail-loading">Loading...</div>';
  panel.onclick = (e) => e.stopPropagation();
  el.appendChild(panel); openDetailEl = el;
  try {
    const res = await fetch('/api/domain/' + encodeURIComponent(domain));
    if (!res.ok) { panel.innerHTML = '<div class="detail-loading">No details available</div>'; return; }
    const d = await res.json();
    const cardType = el.dataset.svcType || d.type || '';
    // Use baseUrl from API (MPP services have full URLs like https://exa.mpp.tempo.xyz).
    // Fallback: strip path from domain (e.g. /mcp) and prepend https://
    const visitUrl = d.baseUrl || `https://${d.domain.includes('/') ? d.domain.split('/')[0] : d.domain}`;
    let html = '';
    if (d.description) html += `<p style="font-size:0.85rem;color:var(--text-dim);margin-bottom:0.5rem;line-height:1.5">${esc(d.description)}</p>`;
    html += '<div class="detail-base">';
    html += `<a href="${esc(visitUrl)}" target="_blank" rel="noopener">${esc(d.domain)}</a>`;
    html += '</div>';
    if (d.seller && d.seller.payTo) html += `<div class="detail-seller">Seller: ${esc(d.seller.payTo)}${d.seller.network ? ' ('+esc(d.seller.network)+')' : ''}</div>`;
    if (d.endpoints && d.endpoints.length) {
      html += '<div class="detail-endpoints">';
      for (const ep of d.endpoints) {
        const isMcp = ep.path.startsWith('mcp:');
        html += `<div class="detail-ep"><span class="ep-path">${esc(ep.path)}</span>`;
        if (ep.price) html += `<span class="ep-price">${esc(ep.price)}</span>`;
        if (ep.description) {
          const full = esc(ep.description), preview = esc(ep.description.slice(0,100));
          if (ep.description.length > 100) {
            const uid = Math.random().toString(36).slice(2);
            html += `<span class="ep-desc"><span class="ep-desc-preview" id="prev-${uid}">${preview}…</span><span class="ep-desc-full" id="full-${uid}">${full}</span><button class="ep-see-more" onclick="event.stopPropagation();(function(){var p=document.getElementById('prev-${uid}'),f=document.getElementById('full-${uid}'),b=event.target;if(f.style.display==='inline'){f.style.display='none';p.style.display='inline';b.textContent='see more';}else{p.style.display='none';f.style.display='inline';b.textContent='less';}})()">see more</button></span>`;
          } else html += `<span class="ep-desc">${full}</span>`;
        }
        if (ep.fullUrl && ep.price && !isMcp) html += `<button class="try-btn" onclick="event.stopPropagation(); window.tryEndpoint('${esc(ep.fullUrl)}','${esc(ep.price)}','${esc(ep.path)}','${esc(d.domain)}')">Try it</button>`;
        html += `</div>`;
      }
      html += '</div>';
    }
    if (!d.endpoints || !d.endpoints.length) {
      if (d.type === 'mcp') {
        html += `<div style="margin-top:0.75rem;padding:0.6rem;background:var(--bg);border:1px solid var(--border);border-radius:6px">`;
        html += `<div style="font-family:var(--mono);font-size:10px;color:var(--text-dim);text-transform:uppercase;letter-spacing:2px;margin-bottom:0.4rem">How to use</div>`;
        html += `<code style="display:block;font-size:11px;color:var(--text);line-height:1.5">Add to MCP config: "url": "https://${esc(d.domain)}"</code>`;
        html += `</div>`;
      } else if (d.type === 'mpp') {
        html += `<div style="margin-top:0.75rem;padding:0.6rem;background:var(--bg);border:1px solid var(--border);border-radius:6px">`;
        html += `<div style="font-family:var(--mono);font-size:10px;color:var(--text-dim);text-transform:uppercase;letter-spacing:2px;margin-bottom:0.4rem">MPP/Tempo Service</div>`;
        html += `<code style="display:block;font-size:11px;color:var(--text);line-height:1.5">${esc(visitUrl)}</code>`;
        html += `<button class="try-btn" style="margin-top:0.5rem" onclick="event.stopPropagation(); window.tryMppEndpoint('${esc(visitUrl)}','${esc(d.domain)}')">Try it</button>`;
        html += `</div>`;
      }
    }
    html += '<div class="detail-actions">';
    html += `<a href="${esc(visitUrl)}" target="_blank">Visit site</a>`;
    if (d.type === 'mpp') html += `<button class="try-btn" onclick="event.stopPropagation(); window.tryMppEndpoint('${esc(visitUrl)}','${esc(d.domain)}')">Try it</button>`;
    html += `<a href="javascript:void(0)" onclick="event.stopPropagation();window.tryEndpoint('https://valoria.net/intelligence/analyze','$5.00','POST /intelligence/analyze','valoria.net')">Deep analysis ($5)</a>`;
    html += '</div>';
    panel.innerHTML = html;
  } catch (err) { panel.innerHTML = '<div class="detail-loading">Failed to load</div>'; }
}

/* ── Feed card overlay detail ── */
async function openDetailOverlay(domain) {
  document.querySelectorAll('.detail-overlay').forEach(p => p.remove());
  const overlay = document.createElement('div');
  overlay.className = 'detail-overlay';
  overlay.onclick = (e) => { if (e.target === overlay) { overlay.remove(); history.replaceState({}, '', location.pathname); } };
  const inner = document.createElement('div');
  inner.className = 'detail-overlay-inner';
  inner.innerHTML = '<button class="detail-overlay-close" onclick="this.closest(\'.detail-overlay\').remove();history.replaceState({},\'\',location.pathname)">&times;</button><div class="detail-loading">Loading...</div>';
  overlay.appendChild(inner);
  document.body.appendChild(overlay);
  history.pushState({active: domain}, '', setUrlParam('active', domain));
  try {
    const res = await fetch('/api/domain/' + encodeURIComponent(domain));
    if (!res.ok) { inner.querySelector('.detail-loading').textContent = 'No details available'; return; }
    const d = await res.json();
    const cardType = d.type || '';
    // Use baseUrl from API (MPP services have full URLs like https://exa.mpp.tempo.xyz).
    const overlayVisitUrl = d.baseUrl || `https://${d.domain.includes('/') ? d.domain.split('/')[0] : d.domain}`;
    let html = '<button class="detail-overlay-close" onclick="this.closest(\'.detail-overlay\').remove();history.replaceState({},\'\',location.pathname)">&times;</button>';
    html += `<h2 style="font-size:1.3rem;font-weight:600;color:#fff;margin-bottom:0.5rem">${esc(d.domain)}</h2>`;
    // Show description if available
    if (d.description) html += `<p style="font-size:0.9rem;color:var(--text-dim);margin-bottom:0.75rem;line-height:1.5">${esc(d.description)}</p>`;
    html += '<div class="detail-base">';
    if (d.type) html += `<span class="result-tag type-${d.type}">${d.type}</span>`;
    if (d.category) html += `<span class="result-tag">${esc(catLabel(d.category))}</span>`;
    if (d.score) html += `<span class="result-tag">score ${d.score}</span>`;
    if (d.revenue) html += `<span class="result-tag revenue">${fmtUsd(d.revenue)} revenue</span>`;
    if (d.payments) html += `<span class="result-tag">${d.payments.toLocaleString()} payments</span>`;
    html += `<button class="share-btn" style="margin-left:auto" onclick="openShareMenu('${esc(d.domain)}',this,event,'${cardType}',${d.revenue||0})" title="Share">${SHARE_SVG}</button>`;
    html += '</div>';
    if (d.seller && d.seller.payTo) html += `<div class="detail-seller" style="margin-top:0.5rem">Seller: ${esc(d.seller.payTo)}${d.seller.network ? ' ('+esc(d.seller.network)+')' : ''}</div>`;
    // For MCP services show tools list even if no paid endpoints
    if (d.endpoints && d.endpoints.length) {
      html += `<div style="margin-top:1rem"><span style="font-family:var(--mono);font-size:11px;color:var(--text-dim);text-transform:uppercase;letter-spacing:2px">${d.type === 'mcp' ? 'Tools' : 'Endpoints'} (${d.endpoints.length})</span></div>`;
      html += '<div class="detail-endpoints" style="margin-top:0.5rem">';
      for (const ep of d.endpoints) {
        const isMcp = ep.path.startsWith('mcp:');
        html += `<div class="detail-ep"><span class="ep-path">${esc(ep.path)}</span>`;
        if (ep.price) html += `<span class="ep-price">${esc(ep.price)}</span>`;
        if (ep.description) html += `<span class="ep-desc">${esc(ep.description)}</span>`;
        if (ep.fullUrl && ep.price && !isMcp) html += `<button class="try-btn" onclick="event.stopPropagation(); window.tryEndpoint('${esc(ep.fullUrl)}','${esc(ep.price)}','${esc(ep.path)}','${esc(d.domain)}')">Try it</button>`;
        html += `</div>`;
      }
      html += '</div>';
    } else if (d.type === 'mcp') {
      // MCP with no individual tools listed — show helpful info
      const overlayMcpDomain = d.domain.includes('/') ? d.domain.split('/')[0] : d.domain;
      html += `<div style="margin-top:1rem;padding:0.75rem;background:var(--bg);border:1px solid var(--border);border-radius:6px">`;
      html += `<div style="font-family:var(--mono);font-size:11px;color:var(--text-dim);text-transform:uppercase;letter-spacing:2px;margin-bottom:0.5rem">How to use</div>`;
      html += `<code style="display:block;font-size:12px;color:var(--text);line-height:1.6">// Add to Claude Desktop MCP config:\n{\n  "mcpServers": {\n    "${esc(overlayMcpDomain)}": {\n      "url": "https://${esc(d.domain)}"\n    }\n  }\n}</code>`;
      html += `</div>`;
    } else if (d.type === 'mpp') {
      html += `<div style="margin-top:1rem;padding:0.75rem;background:var(--bg);border:1px solid var(--border);border-radius:6px">`;
      html += `<div style="font-family:var(--mono);font-size:11px;color:var(--text-dim);text-transform:uppercase;letter-spacing:2px;margin-bottom:0.5rem">MPP/Tempo Service</div>`;
      html += `<code style="display:block;font-size:12px;color:var(--text);line-height:1.6">${esc(overlayVisitUrl)}</code>`;
      html += `<button class="try-btn" style="margin-top:0.75rem" onclick="event.stopPropagation(); window.tryMppEndpoint('${esc(overlayVisitUrl)}','${esc(d.domain)}')">Try it</button>`;
      html += `</div>`;
    }
    html += '<div class="detail-actions" style="margin-top:1rem">';
    html += `<a href="${esc(overlayVisitUrl)}" target="_blank">Visit site</a>`;
    if (d.type === 'mpp') html += `<button class="try-btn" onclick="event.stopPropagation(); window.tryMppEndpoint('${esc(overlayVisitUrl)}','${esc(d.domain)}')">Try it</button>`;
    html += `<a href="javascript:void(0)" onclick="window.tryEndpoint('https://valoria.net/intelligence/analyze','$5.00','POST /intelligence/analyze','valoria.net')">Deep analysis ($5)</a>`;
    html += '</div>';
    inner.innerHTML = html;
  } catch (err) {
    inner.innerHTML = '<button class="detail-overlay-close" onclick="this.closest(\'.detail-overlay\').remove()">&times;</button><div class="detail-loading">Failed to load</div>';
  }
}
document.addEventListener('keydown', (e) => { if (e.key === 'Escape') document.querySelectorAll('.detail-overlay').forEach(p => { p.remove(); history.replaceState({}, '', location.pathname); }); });

/* ── Quick Start Tabs ── */
document.querySelectorAll('.tabs .tab-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.tabs .tab-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById(btn.dataset.tab).classList.add('active');
  });
});

/* ── Keyboard shortcut: / to focus search ── */
document.addEventListener('keydown', (e) => {
  if (e.key === '/' && document.activeElement !== input && !e.ctrlKey && !e.metaKey && !e.altKey) {
    const tag = document.activeElement?.tagName;
    if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
    e.preventDefault();
    input.focus();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }
});

/* ── Hide / kbd hint when input focused ── */
const searchKbd = document.getElementById('searchKbd');
input.addEventListener('focus', () => { if (searchKbd) searchKbd.style.display = 'none'; });
input.addEventListener('blur', () => { if (searchKbd && !input.value) searchKbd.style.display = ''; });

/* ── Intersection Observer for scroll reveal ── */
const revealObserver = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      entry.target.classList.add('reveal');
      revealObserver.unobserve(entry.target);
    }
  });
}, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

document.querySelectorAll('.page-section, .feed-row, .dash-card, .price-card').forEach(el => {
  el.style.opacity = '0';
  revealObserver.observe(el);
});
</script>
