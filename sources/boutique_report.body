<script>
  var hsLoaded = false;
  function loadHubSpot(){
    if (hsLoaded) return; hsLoaded = true;
    var s = document.createElement('script');
    s.src = '//js.hs-scripts.com/23264651.js';  // your portal id, from the capture
    s.async = true;
    document.head.appendChild(s);
  }
  ['scroll','mousemove','touchstart','click','keydown'].forEach(function(evt){
    window.addEventListener(evt, loadHubSpot, { once:true, passive:true });
  });
  window.addEventListener('load', function(){ setTimeout(loadHubSpot, 5000); });
</script>
<!-- End of HubSpot Embed Code -->

<!-- Youtube URL Parser -->
<script>
function getYouTubeId(url){
  if(!url) return '';
  url = String(url);
  var m = url.match(/[?&]v=([A-Za-z0-9_-]{11})/);                          // watch?v=
  if(m) return m[1];
  m = url.match(/(?:youtu\.be\/|\/embed\/|\/shorts\/|\/v\/)([A-Za-z0-9_-]{11})/); // youtu.be, embed, shorts
  if(m) return m[1];
  m = url.match(/([A-Za-z0-9_-]{11})/);                                    // fallback: bare ID
  return m ? m[1] : '';
}
document.addEventListener('click', function (e) {
  var el = e.target.closest('.yt-facade');
  if (!el || el.dataset.loaded) return;
  var id = getYouTubeId(el.getAttribute('data-videourl'));
  if (!id) return;
  el.dataset.loaded = '1';
  var iframe = document.createElement('iframe');
  iframe.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1';
  iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
  iframe.title = 'YouTube video player';
  iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0;';
  el.innerHTML = '';
  el.appendChild(iframe);
});
</script>

</body></html>