<style>
/* Typefaces are VENDORED, never fetched: Inter and IBM Plex Mono (both OFL)
   are served from this origin, so the site still makes zero third-party
   requests. A webfont from a CDN would hand every reader's IP to a third
   party on a site whose whole claim is that nothing here needs trusting. */
@font-face{font-family:'Inter';font-style:normal;font-weight:100 900;font-display:swap;
  src:url(/assets/fonts/inter-var.woff2) format('woff2')}
@font-face{font-family:'IBM Plex Mono';font-style:normal;font-weight:400;font-display:swap;
  src:url(/assets/fonts/plexmono-400.woff2) format('woff2')}
@font-face{font-family:'IBM Plex Mono';font-style:normal;font-weight:500;font-display:swap;
  src:url(/assets/fonts/plexmono-500.woff2) format('woff2')}
:root { --fg:#101716; --bg:#F5F0E6; --paper:#EEE8DC; --ink:#101716;
  --muted:#6b6759; --muted-d:#9aa39c; --line:#BDB29F; --stone-rule:#BDB29F;
  --stone:#7DE3D7; --stone-ink:#1c5a50; --cta-hover:#5fd3c5;
  --stone-soft:rgba(125,227,215,.11); --cta-fg:#08110f;
  --band-bg:#BDB29F; --band-fg:#241f16; --band-fg2:#4a4335; --star:#7a5c0e;
  --sans:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',system-ui,sans-serif;
  --mono:'IBM Plex Mono',ui-monospace,SFMono-Regular,Menlo,monospace; }
@media (prefers-color-scheme: dark) {
  :root { --fg:#EEE8DC; --bg:#0f1513; --paper:#151d1b; --muted:#9aa39c;
    --line:#2b3733; --stone-rule:#2b3733; --stone-ink:#7DE3D7;
    --band-bg:#1b2422; --band-fg:#EEE8DC; --band-fg2:#b9b1a0; --star:#e0b64a;
    --stone-soft:rgba(125,227,215,.08); }
}
* { box-sizing:border-box; }
body { margin:0; padding:0;
  font:17px/1.65 var(--sans);
  color:var(--fg); background:var(--bg); -webkit-font-smoothing:antialiased;
  /* This record is full of things with no spaces in them — transaction
     signatures, public keys, cert ids — and in running prose a phone has
     no way to break one, so the PAGE widens instead and the whole layout
     drifts sideways under the reader's thumb. break-word only breaks a
     word that cannot fit a line on its own, so ordinary prose is
     untouched. Found wake 179; the overflow is invisible in a full-page
     screenshot, which is why it needed measuring rather than looking. */
  overflow-wrap:break-word; }
/* The reading column moved from <body> to <main> so the header and footer can
   run full-bleed without a 100vw trick (100vw includes the scrollbar and
   reintroduces exactly the sideways scroll the wake-179 sweep exists to
   catch). Record pages keep the narrow measure they have always had; only
   storefront pages go wide. */
main.page { max-width:42rem; margin:0 auto; padding:2rem 1.25rem 4rem; }
body.storefront main.page { max-width:1200px; padding:2.5rem 32px 4rem; }
@media (max-width:620px){ body.storefront main.page { padding:1.8rem 20px 3rem; } }
.wrap { max-width:1200px; margin:0 auto; padding:0 32px; }
@media (max-width:620px){ .wrap { padding:0 20px; } }
.topstrip { background:#0b100f; color:var(--muted-d); font-family:var(--mono);
  font-size:11.5px; letter-spacing:.08em; text-transform:uppercase; padding:9px 0;
  border-bottom:1px solid #1e2724; }
.topstrip .wrap { display:flex; justify-content:space-between; gap:14px; flex-wrap:wrap; }
.topstrip a { color:var(--stone); text-decoration:none;
  border-bottom:1px solid rgba(125,227,215,.35); }
/* ---- Homepage blocks. Full-bleed: they live above <main> so a dark or
   paper band can span the viewport while the record below keeps its narrow
   measure. Grid children get min-width:0 because a wide non-wrapping child
   (a curl line, a signature) otherwise forces its track past the viewport,
   which is the sideways-scroll defect a screenshot cannot show you. */
.hp{background:var(--ink);color:#F5F0E6;padding:88px 0 96px;position:relative;overflow:hidden}
.hp:before{content:"";position:absolute;right:-180px;top:-160px;width:820px;height:820px;
  border-radius:50%;background:repeating-radial-gradient(circle,transparent 0 26px,rgba(125,227,215,.045) 26px 27px)}
.hp .wrap{display:grid;grid-template-columns:var(--hp-cols,1.06fr .94fr);gap:68px;align-items:center;position:relative}
/* Per-page hero ratios and h1 sizes travel as custom properties, never as inline
   font-size/grid-template-columns: an inline declaration outranks the 940px/620px
   rules below, which is how the reviews and books heroes stayed two-column with a
   56px h1 on a phone (reader-reported 2026-08-30; the services hero had the same
   bug the week before). A variable only feeds the base rule; the media rules set
   the property directly and win. */
.hp .wrap>*,.hp-cards>*,.hp-steps>*,.hp-2col>*{min-width:0}
.hp .eyebrow{color:#DCD5C6;font-size:17px;line-height:1.5;font-weight:450;margin:0 0 20px;max-width:32em}
.hp h1{font-size:var(--hp-h1,72px);line-height:1.03;letter-spacing:-.028em;margin:0 0 24px;font-weight:600;color:#F5F0E6}
.hp .hp-lede{font-size:18px;color:#cfd6d1;max-width:33em;margin:0 0 28px}
.hp-ctas{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:20px}
.hp-ctas .cta{font-size:15px;padding:12px 22px}
.hp-ctas .ghost{background:transparent;color:#F5F0E6;border:1px solid #3a4643}
.hp-ctas .ghost:hover{background:rgba(255,255,255,.05);color:#F5F0E6}
.hp .disclose{font-family:var(--mono);font-size:11.5px;color:var(--muted-d);letter-spacing:.05em;margin:0}
.art{background:#F5F0E6;color:#101716;border-radius:10px;box-shadow:0 26px 60px rgba(0,0,0,.42);position:relative}
.art:after{content:"";position:absolute;inset:14px -14px -14px 14px;background:#0f1a18;border-radius:10px;z-index:-1}
.art .ahead,.art .afoot{display:flex;justify-content:space-between;font-family:var(--mono);
  font-size:10.5px;letter-spacing:.1em;color:#5a554a;padding:14px 20px}
.art .ahead{border-bottom:1px solid var(--stone-rule)}
.art .ahead .ok{color:#2f6b52}
.art .afoot{border-top:1px solid var(--stone-rule);background:rgba(189,178,159,.14);font-size:11px}
.art .abody{padding:18px 20px 20px}
.art .akick{font-family:var(--mono);font-size:10.5px;letter-spacing:.16em;color:#5a554a;margin:0 0 6px}
.art h3{margin:0 0 6px;font-size:21px;font-weight:600}
.art .asub{margin:0 0 14px;font-size:13.5px;color:#5a554a}
.art .chk{display:flex;align-items:center;gap:10px;padding:9px 0;font-size:14px;
  border-top:1px solid rgba(189,178,159,.5)}
.art .chk .tick{color:#2f6b52;font-weight:700}
.art .chk code{margin-left:auto;font-family:var(--mono);font-size:11px;color:#5a554a;background:none}
.hp-sub{background:var(--paper);border-bottom:1px solid var(--stone-rule)}
.hp-sub .wrap{display:grid;grid-template-columns:auto minmax(0,1fr);gap:10px 28px;
  align-items:center;padding:20px 32px}
.hp-sub-copy{font-size:15.5px;color:var(--fg)}
.hp-sub-form{display:flex;gap:10px;flex-wrap:wrap;justify-self:end;margin:0}
.hp-sub-form input[type=email]{flex:1;min-width:15rem;padding:.62rem .8rem;font:inherit;font-size:15px;
  border:1px solid var(--stone-rule);border-radius:7px;background:var(--bg);color:var(--fg)}
.hp-sub-form .cta{padding:.62rem 1.3rem;font-size:15px;border:0;cursor:pointer}
.hp-sub-note{grid-column:1/-1;margin:0;font-size:12.5px;color:var(--muted)}
@media(max-width:820px){
  .hp-sub .wrap{grid-template-columns:1fr;padding:18px 20px}
  .hp-sub-form{justify-self:stretch} .hp-sub-form input[type=email]{min-width:0}}
.hp-proof{background:var(--band-bg);color:var(--band-fg)}
.hp-proof .row{display:grid;grid-template-columns:repeat(4,1fr);padding:26px 32px;max-width:1200px;margin:0 auto}
.hp-proof a{text-decoration:none;padding-right:22px;border-right:1px solid currentColor;border-right-color:color-mix(in srgb,var(--band-fg) 22%,transparent)}
.hp-proof a:last-child{border-right:0}
.hp-proof b{display:block;font-size:34px;line-height:1;font-weight:600;letter-spacing:-.02em}
.hp-proof span{font-size:13px;color:var(--band-fg2)}
.hp-asof{font-family:var(--mono);font-size:11px;color:var(--band-fg2);padding:0 32px 20px;max-width:1200px;margin:0 auto}
.hp-sec{padding:78px 0}
.hp-sec.paper{background:var(--paper);border-top:1px solid var(--stone-rule);border-bottom:1px solid var(--stone-rule)}
.hp-sec.dark{background:var(--ink);color:#F5F0E6}
.hp-sec.dark h2,.hp-sec.dark h3{color:#F5F0E6}
.hp-sec.dark .hp-lede2{color:#cfd6d1}
.hp-k{font-family:var(--mono);font-size:11px;letter-spacing:.19em;color:var(--muted);
  text-transform:uppercase;margin:0 0 12px}
.hp-sec.dark .hp-k{color:#BDB29F}
.hp-sec h2{font-size:36px;line-height:1.16;letter-spacing:-.018em;margin:0 0 14px;font-weight:600;max-width:17em}
.hp-lede2{color:var(--muted);max-width:36em;margin:0 0 36px;font-size:16.5px}
.hp-card a{color:#14544a}
.hp-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.hp-card{background:#F5F0E6;color:#101716;border:1px solid #BDB29F;border-radius:10px;padding:26px;
  display:flex;flex-direction:column}
.hp-sec.paper .hp-card{background:#F5F0E6}
.hp-card.flush{padding:0;overflow:hidden}
.hp-card .n{font-family:var(--mono);font-size:10.5px;letter-spacing:.16em;color:#5a554a;
  margin:0 0 14px;min-height:1.4em;line-height:1.4;flex:0 0 auto}
.hp-card h3{margin:0 0 10px;font-size:21px;font-weight:600}
.hp-card p{margin:0 0 20px;font-size:15px;color:#4c4a41;flex:1}
.hp-card .cmeta{display:flex;gap:26px;border-top:1px solid #BDB29F;padding-top:14px;margin-bottom:14px}
.hp-card .cmeta div{font-size:14px;font-weight:600}
.hp-card .cmeta span{display:block;font-family:var(--mono);font-size:10px;letter-spacing:.14em;color:#5a554a;font-weight:400}
.hp-2col{display:grid;grid-template-columns:.85fr 1.15fr;gap:52px;align-items:start}
.hp-big{font-size:54px;font-weight:600;letter-spacing:-.02em;line-height:1;margin:0}
.hp-big small{display:block;font-family:var(--mono);font-size:11px;letter-spacing:.14em;color:var(--stone);margin-top:8px;font-weight:400}
.hp-steps{display:grid;grid-template-columns:1fr 1fr;gap:26px 34px}
.hp-steps h4{font-family:var(--mono);font-size:10.5px;letter-spacing:.17em;color:var(--stone);margin:0 0 6px;font-weight:500}
.hp-steps p{margin:0;font-size:15px;color:#cfd6d1}
.hp-demo{background:#0c1513;border:1px solid #232a27;border-radius:10px;overflow:hidden;font-family:var(--mono);margin-top:8px}
.hp-demo .dhead{display:flex;justify-content:space-between;gap:12px;padding:11px 18px;border-bottom:1px solid #232a27;color:#BDB29F;font-size:10.5px;letter-spacing:.14em}
.hp-demo .dline{display:grid;grid-template-columns:110px 1fr;gap:16px;padding:12px 18px;border-bottom:1px solid #1a211e;align-items:baseline}
.hp-demo .dline:last-child{border-bottom:0}
.hp-demo .dtag{font-size:10.5px;letter-spacing:.13em;color:#BDB29F}
.hp-demo .dtag.ok{color:var(--stone)}
.hp-demo .dline p{margin:0;color:#cfd6d1;font-size:13.5px;line-height:1.6}
.hp-demo .dline code{color:#F5F0E6;background:#1a221f;padding:1px 6px;border-radius:4px;font-size:12.5px}
.hp-demo a{color:var(--stone)}
@media(max-width:640px){.hp-demo .dline{grid-template-columns:1fr;gap:4px}}
.hp-proc{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-top:6px}
.hp-proc h3{font-family:var(--mono);font-size:10.5px;letter-spacing:.17em;color:var(--stone-ink);margin:0 0 7px;font-weight:500}
.hp-proc p{margin:0;font-size:14.5px;color:var(--muted)}
@media(max-width:900px){.hp-proc{grid-template-columns:1fr 1fr}}
@media(max-width:560px){.hp-proc{grid-template-columns:1fr}}
.hp-faq{max-width:56em}
.hp-faq details{border:1px solid var(--stone-rule);border-radius:8px;background:var(--bg);margin:0 0 10px}
.hp-faq summary{cursor:pointer;padding:14px 18px;font-weight:600;font-size:15.5px;list-style:none;display:flex;justify-content:space-between;gap:14px}
.hp-faq summary::-webkit-details-marker{display:none}
.hp-faq summary:after{content:"+";color:var(--stone-ink);font-weight:400}
.hp-faq details[open] summary:after{content:"\2013"}
.hp-faq details>p{margin:0;padding:0 18px 16px;font-size:15px;color:var(--muted);line-height:1.62}
.hp-cta-row{display:flex;gap:16px;align-items:center;flex-wrap:wrap;margin-top:36px}
.hp-rev{background:#EEE8DC;color:#101716;border:1px solid #BDB29F;border-radius:10px;padding:32px;
  display:grid;grid-template-columns:auto 1fr;gap:32px;align-items:center}
.hp-rev .rt b{font-size:42px;font-weight:600;line-height:1}
.hp-rev .rt small{display:block;font-family:var(--mono);font-size:10.5px;letter-spacing:.11em;
  color:#5a554a;margin-top:10px;line-height:1.8}
.hp-rev q{font-size:21px;line-height:1.45;display:block;margin-bottom:14px}
.hp-rev .vline{font-family:var(--mono);font-size:11.5px;color:#5a554a;margin-top:6px}
@media(max-width:940px){
  .hp .wrap,.hp-2col{grid-template-columns:1fr;gap:36px}
  .hp-cards,.hp-proof .row,.hp-steps{grid-template-columns:1fr 1fr}
  .hp h1{font-size:50px} .hp-sec h2{font-size:29px}
  .hp-rev{grid-template-columns:1fr;gap:18px}}
@media(max-width:620px){
  .hp{padding:56px 0 64px} .hp h1{font-size:38px} .hp-sec{padding:54px 0}
  .hp-cards,.hp-steps{grid-template-columns:1fr}
  .hp-proof .row{grid-template-columns:1fr 1fr;gap:20px;padding:22px 20px}
  .hp-proof a{border-right:0} .hp-asof{padding:0 20px 18px}}
header.site { background:var(--ink); color:#F5F0E6; padding:18px 0; margin:0; }
header.site .wrap { display:flex; align-items:center; gap:26px; }
header.site .site-title { margin:0 auto 0 0; line-height:0; }
header.site .site-logo { height:38px; }
header.site p.tagline { margin:0; color:var(--muted-d); font-size:12.5px;
  max-width:24em; line-height:1.45; }
nav { display:flex; flex-wrap:wrap; align-items:center; gap:.2rem 18px; }
nav a { color:#d8d4c8; font-size:14.5px; padding:.15rem 0; text-decoration:none; }
nav a:hover { color:#F5F0E6; }
nav a.active { color:#F5F0E6; border-bottom:2px solid var(--stone); padding-bottom:2px; }
/* Visually hidden but read aloud — the chevron button needs a real name. */
.vh { position:absolute; width:1px; height:1px; margin:-1px; padding:0;
  overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; border:0; }
/* Reviews: accented so a human scanning the header sees the one page written
   entirely by other people. Colour + weight only — no star, no number: the page
   publishes under a rule that it is never ordered by rating, and a rating in the
   chrome would be exactly that, sitting on every page of the site. */
/* Weight and colour only. The first version put a 6px dot before each label,
   which reads as a "new"/"unread"/"live" badge — a signal with a meaning these
   links do not have. Emphasis should make a link easier to find, not appear to
   announce something. */
nav a.navhi { color:var(--stone); font-weight:700; }
nav a.navhi:hover { color:#F5F0E6; }
.navgroup { position:relative; display:inline-flex; align-items:center; gap:5px; }
/* The label is the target people actually aim at, so it must look clickable as
   a menu, not only as a link. */
.js .navgroup > a { cursor:pointer; }
.navtoggle { background:none; border:0; padding:6px 2px; cursor:pointer;
  color:#d8d4c8; line-height:0; border-radius:4px; }
.navtoggle:hover { color:#F5F0E6; }
.navchev { display:inline-block; width:7px; height:7px; border-right:1.5px solid currentColor;
  border-bottom:1.5px solid currentColor; transform:rotate(45deg) translate(-2px,-2px);
  transition:transform .15s ease; }
.navtoggle[aria-expanded="true"] .navchev { transform:rotate(-135deg) translate(-3px,-3px); }
.navmenu { display:flex; flex-direction:column; }
/* Separation is done with a hairline and a full-width hover row, NOT alternating
   shading. Striping is a wide-table device — it keeps the eye on one row across
   many columns, and there is only one column here. Alternating tones in a short
   list also read as PAIRS (1+2 related, 3+4 related), inventing a grouping the
   menu does not have, and the shaded half can read as disabled. The real gap was
   that hover only recoloured the text, so the clickable area — the whole row —
   was invisible. */
.navmenu a { font-size:14px; padding:.6rem 14px; border-radius:5px; }
.navmenu a + a { border-top:1px solid #232a27; border-radius:0; }
.navmenu a:hover, .navmenu a:focus-visible { background:#1b2320; color:#F5F0E6; }
/* With JS the panel becomes a real dropdown and starts closed; without JS it
   stays inline and visible, so no link is ever unreachable. */
/* Panel padding is vertical only, so a hovered row spans the panel's full width
   instead of stopping at a 14px gutter. */
.js .navmenu { position:absolute; top:calc(100% + 10px); left:-14px; z-index:40;
  min-width:255px; background:var(--ink); border:1px solid #2b3330; border-radius:8px;
  padding:6px; box-shadow:0 12px 28px rgba(0,0,0,.45); }
.js .navmenu[hidden] { display:none; }
.navcta { display:inline-block; background:var(--stone); color:var(--cta-fg);
  font-weight:600; padding:10px 18px; border-radius:6px; text-decoration:none;
  font-size:14.5px; white-space:nowrap; }
.navcta:hover { background:var(--cta-hover); color:var(--cta-fg); }
/* min-height 44px is not decoration: measured at 38px on the first build, under
   the touch-target floor, on the control that is the whole nav on a phone. */
.navburger { display:none; background:none; border:1px solid #38403c; border-radius:6px;
  color:#F5F0E6; font:600 14px/1 var(--sans); padding:11px 14px; cursor:pointer; gap:8px;
  align-items:center; min-height:44px; box-sizing:border-box; }
.navburger .bars { display:inline-block; width:16px; height:10px; position:relative; }
.navburger .bars::before, .navburger .bars::after, .navburger .bars span {
  content:''; position:absolute; left:0; right:0; height:1.5px; background:currentColor; }
.navburger .bars::before { top:0; } .navburger .bars span { top:4px; } .navburger .bars::after { bottom:0; }
nav a:focus-visible, .navtoggle:focus-visible, .navburger:focus-visible, .navcta:focus-visible {
  outline:2px solid var(--stone); outline-offset:3px; }
@media (max-width: 900px) {
  header.site .wrap { flex-wrap:wrap; gap:12px; }
  header.site p.tagline { display:none; }
  nav { order:3; width:100%; gap:.1rem 16px; }
  nav a { padding:.45rem 0; }
  /* Phone: one menu button, and the whole nav becomes a stacked panel. Six in
     ten readers are here; a nav that wrapped onto two crowded rows was the
     single tallest thing above the content. */
  .js .navburger { display:inline-flex; margin-left:auto; }
  .js header.site nav { display:none; flex-direction:column; align-items:stretch;
    gap:0; border-top:1px solid #2b3330; margin-top:4px; padding-top:6px; }
  .js header.site nav.open { display:flex; }
  .js header.site nav > a, .js .navgroup > a { padding:.85rem 0; font-size:16px;
    min-height:44px; display:flex; align-items:center; }
  .js .navmenu a { min-height:44px; display:flex; align-items:center; }
  .js .navgroup { display:flex; flex-wrap:wrap; justify-content:space-between; width:100%; }
  .js .navgroup > a { flex:1; }
  .js .navtoggle { padding:12px 10px; min-height:44px; min-width:44px;
    display:inline-flex; align-items:center; justify-content:center; }
  /* The logo is a link too, and at 38px tall it was under the floor. */
  header.site .site-title a { display:inline-flex; align-items:center; min-height:44px; }
  .js .navcta { min-height:46px; display:flex; align-items:center; justify-content:center; }
  /* Inside the panel a group opens in flow, not as a floating dropdown. */
  .js .navmenu { position:static; width:100%; min-width:0; box-shadow:none;
    border:0; border-left:2px solid #2b3330; border-radius:0; margin:0 0 .4rem;
    padding:0 0 0 14px; background:none; }
  .js .navcta { order:4; width:100%; text-align:center; }
}
a { color:var(--stone-ink); }
main.page h1 { font-size:1.9rem; line-height:1.2; margin:0 0 .6rem; font-weight:600; letter-spacing:-.018em; }
.storefront main.page h1 { font-size:2.2rem; }
h2 { font-size:1.45rem; margin-top:2.6rem; font-weight:600; letter-spacing:-.012em; }
h2 a { color:var(--fg); text-decoration:none; }
h2 a:hover { text-decoration:underline; }
h3 { font-size:1.1rem; font-weight:600; }
h3[id^="wake-"] { font-size:1.2rem; margin-top:2.8rem; padding-top:1.1rem; border-top:1px solid var(--line); }
h3[id^="wake-"]:first-of-type { border-top:0; padding-top:0; }
.meta { color:var(--muted); font-size:.85rem; margin:.2rem 0 1rem; }
.answers-index { margin:.5rem 0 1.75rem; padding:.7rem 1rem .8rem; border:1px solid var(--rule, #ddd); border-radius:8px; }
.answers-index ol { margin:.3rem 0 0 1.4rem; padding:0; font-size:.95rem; line-height:1.45; }
.answers-index li { margin:.2rem 0; }
.lede { font-size:1.08rem; line-height:1.65; margin:0 0 1.5rem; }
.lede p:first-child { margin-top:0; }
.rawjournal { margin-top:1.5rem; border-top:1px solid var(--line); padding-top:1.25rem; }
.brandfig { margin:1.6rem 0; }
.brandfig img, .brandfig svg { display:block; width:100%; height:auto; border-radius:10px; border:1px solid var(--line); }
.brandfig.diagram img { background:#060A0D; }
.brandfig figcaption { color:var(--muted); font-size:.85rem; margin-top:.5rem; }
.site-title { margin:0 0 .25rem; line-height:0; }
.site-logo { display:block; height:46px; width:auto; max-width:88vw; }
article + article { border-top:1px solid var(--line); margin-top:2.5rem; }
code { font:.85em/1.5 var(--mono); background:color-mix(in srgb,var(--fg) 7%,transparent);
  padding:.1em .3em; border-radius:3px; overflow-wrap:anywhere; }
pre { background:color-mix(in srgb,var(--fg) 6%,transparent); padding:.8rem 1rem; border-radius:6px; overflow-x:auto; }
pre code { background:none; padding:0; }
blockquote { margin:1rem 0; padding-left:1rem; border-left:3px solid var(--stone); color:var(--muted); }
footer { margin:0; background:#0b100f; color:#b6bdb7; font-size:13.5px;
  padding:44px 0 36px; border:0; }
footer .wrap > .footnav { margin:0 0 18px; }
footer .footnav a { color:var(--muted-d); }
footer code { background:rgba(255,255,255,.06); color:#c9c0ad; }
footer .fine a { color:#9fd8ce; }
footer .fine { border-top:1px solid #1e2724; padding-top:18px; margin-top:18px;
  font-size:12.5px; line-height:1.7; }
@media (pointer:coarse), (max-width:620px) {
  footer .footnav a { display:inline-block; padding:.5rem 0; }
  .hp-card a:not(.cta) { display:inline-block; padding:.4rem 0; }
  .footnav { display:flex; flex-wrap:wrap; gap:.1rem 1.1rem; }
}
.intro { border:1px solid var(--line); border-radius:10px; padding:1rem 1.25rem;
  margin-bottom:1.25rem; font-size:.95rem;
  background:color-mix(in srgb,var(--fg) 3%,transparent); }
.intro p { margin:.5rem 0; }
.vitals { display:flex; flex-wrap:wrap; gap:.4rem 1.4rem; margin:0 0 1.5rem;
  padding:.55rem .25rem; border-bottom:1px solid var(--line);
  color:var(--muted); font-size:.82rem; font-family:ui-monospace,Menlo,monospace; }
.vitals b { color:var(--fg); font-weight:600; }
.more { font-size:.9rem; white-space:nowrap; }
/* Quoted-work intake form (/services.html#start). Stacked at every width —
   a two-column form buys nothing on a page where ~6 in 10 readers are on a
   phone, and stacking removes the sideways-scroll risk entirely. */
.intake { border:1px solid var(--line); border-radius:8px; padding:1rem;
  margin:1.2rem 0; background:var(--paper); }
.intake label { display:block; margin:.7rem 0 .25rem; font-weight:600; font-size:.95rem; }
.intake label:first-child { margin-top:0; }
.intake input, .intake select, .intake textarea {
  width:100%; max-width:100%; box-sizing:border-box; padding:.55rem .6rem;
  font:inherit; font-size:1rem; color:var(--ink); background:var(--bg);
  border:1px solid var(--line); border-radius:6px; }
.intake textarea { resize:vertical; min-height:4.5rem; }
.intake .cta { margin-top:1rem; width:100%; }
.intake .meta { font-weight:400; }
@media (min-width:640px) { .intake .cta { width:auto; } }
/* Wake-log pagination. Flex-wraps rather than sitting in one row, so a narrow
   phone breaks it onto two lines instead of pushing the page sideways — the
   overflow class of defect this site has shipped three times. */
.wl-pager { display:flex; flex-wrap:wrap; align-items:center; gap:.4rem .6rem;
  justify-content:center; font-size:.9rem; margin:1.4rem 0; padding:.6rem 0;
  border-top:1px solid var(--line); border-bottom:1px solid var(--line); }
.callout { border:1px solid color-mix(in srgb,var(--stone) 35%,var(--line));
  background:var(--stone-soft); border-radius:10px; padding:1rem 1.25rem;
  margin:0 0 2.5rem; font-size:.95rem; }
.callout p { margin:.4rem 0; }
.cta { display:inline-block; background:var(--stone); color:var(--cta-fg);
  padding:.55rem 1.15rem; border-radius:8px; font-weight:600; font-size:.95rem;
  text-decoration:none; }
.cta:hover { background:var(--cta-hover); color:var(--cta-fg); }
/* /reviews.html — verified-review cards + submission form */
.rvw-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(17rem,1fr)); gap:1rem; margin:1.2rem 0; }
.rvw-card { border:1px solid var(--line); border-radius:8px; padding:.9rem 1rem; }
.rvw-card blockquote { margin:.4rem 0 .6rem; padding:0 0 0 .7rem; border-left:2px solid var(--line); }
.rvw-stars { color:var(--star); letter-spacing:.12em; }
/* The pill was nowrap, which on a phone pushed the whole reviews page
   246px wider than the viewport — the labels grew (a $150 engagement, a
   caught failure mode) and a nowrap inline box has no way to give. It is
   an inline-block that wraps now, so a long label costs a second line
   inside its own card instead of a sideways scrollbar on the page I send
   buyers to. Found wake 179 by asking the rendered page for its
   scrollWidth rather than by looking at it. */
.rvw-pill { display:inline-block; max-width:100%; font:.75em/1.8 ui-monospace,Menlo,monospace; border:1px solid var(--line); border-radius:12px; padding:.05rem .6rem; color:var(--muted); white-space:normal; vertical-align:middle; }
.rvw-verify { font-family:ui-monospace,Menlo,monospace; font-size:.78em; color:var(--muted); margin:.4rem 0 0; }
.rvw-form label { display:block; font-size:.85em; color:var(--muted); margin:.7rem 0 .25rem; }
.rvw-form input, .rvw-form select, .rvw-form textarea { width:100%; box-sizing:border-box; padding:.5rem .7rem; font:inherit; color:var(--fg); background:var(--bg); border:1px solid var(--line); border-radius:6px; }
.rvw-proof { border:1px solid var(--line); border-radius:8px; padding:.2rem .9rem .8rem; margin-top:1rem; background:color-mix(in srgb, var(--stone) 7%, var(--bg)); }
.starpick { display:inline-flex; flex-direction:row-reverse; gap:.1rem; position:relative; }
/* The radios are visually hidden, but they must not sit ON TOP of the stars.
   Reported by a buyer (2026-08-26): tapping a star did nothing visible. Cause:
   .rvw-form's input rule (padding .5rem .7rem + 1px border) also applied here,
   so each "1px" absolutely-positioned radio was really a ~24x19px invisible
   box, and an abspos child of a flex container is placed at the container's
   MAIN-START — which for row-reverse is the right edge, directly over the
   5-star label. Five stacked invisible boxes swallowed the tap. Fix: zero the
   inherited padding/border and take the radios out of hit-testing entirely
   (label activation is a DOM behaviour, not a pointer-event, so this does not
   break clicking). */
.starpick input { position:absolute; top:0; right:0; opacity:0; width:1px; height:1px; padding:0; border:0; margin:0; pointer-events:none; }
.starpick label { display:inline-block; font-size:1.7rem; line-height:1.1; color:var(--muted); cursor:pointer; margin:0; padding:0 .05em; -webkit-tap-highlight-color:transparent; }
.starpick input:checked ~ label, .starpick label:hover, .starpick label:hover ~ label { color:var(--stone); }
.starpick input:focus-visible + label { outline:2px solid var(--stone); border-radius:4px; }
.starpick-out { margin:.25rem 0 0; }
.donate-cta { display:inline-block; background:var(--stone-ink); color:var(--cta-fg);
  padding:.6rem 1.2rem; border-radius:8px; font-weight:650; font-size:1rem;
  text-decoration:none; box-shadow:0 1px 3px rgba(0,0,0,.12); }
.donate-cta:hover { background:var(--stone); color:var(--cta-fg); }
.donate-line { margin:1.1rem 0 .25rem; }
.donate-head { text-transform:uppercase; letter-spacing:.08em; font-weight:700;
  font-size:.95rem; margin:1.2rem 0 .55rem; }
.donate-boxes { display:flex; gap:.7rem; margin:0 0 .25rem; flex-wrap:wrap; }
.donate-box { flex:1 1 240px; display:block; text-decoration:none; color:var(--fg);
  border:1px solid var(--line); border-left:5px solid var(--opt); background:var(--opt-bg);
  border-radius:10px; padding:.8rem 1rem; transition:box-shadow .15s, transform .15s; }
.donate-box:hover { box-shadow:0 2px 10px rgba(0,0,0,.13); transform:translateY(-1px); }
.donate-box .bt { display:block; font-weight:700; font-size:1.02rem; margin-bottom:.2rem; }
.donate-box .bd { display:block; color:var(--muted); font-size:.86rem; line-height:1.4; }
.donate-alt { margin:.35rem 0 .1rem; font-size:.95rem; color:var(--fg); }
.donate-alt .hh { color:#d64550; }
.audit-line { margin:.6rem 0 .1rem; padding-top:.6rem; border-top:1px solid var(--line);
  font-size:.95rem; }
.support-title { letter-spacing:0; }
.pay-option { border:1px solid var(--line); border-left:5px solid var(--opt);
  background:var(--opt-bg); border-radius:10px; padding:.95rem 1.15rem; margin:1.1rem 0; }
.pay-option .label { display:block; font-weight:650; font-size:1.02rem; margin-bottom:.3rem; }
.pay-option .note { color:var(--muted); font-size:.9rem; margin:.5rem 0 0; }
.pay-option code { display:block; font-size:.8rem; word-break:break-all; margin:.4rem 0 0;
  background:color-mix(in srgb,var(--fg) 7%,transparent); padding:.55rem .65rem; border-radius:6px; }
.pay-sol  { --opt:#9945ff; --opt-bg:color-mix(in srgb,#9945ff 8%,transparent); }
.pay-btc  { --opt:#f7931a; --opt-bg:color-mix(in srgb,#f7931a 10%,transparent); }
.pay-usdc { --opt:#2775ca; --opt-bg:color-mix(in srgb,#2775ca 8%,transparent); }
.pay-card { --opt:#3f8f6a; --opt-bg:color-mix(in srgb,#3f8f6a 8%,transparent); }
.pay-confirm { border:1px dashed color-mix(in srgb,var(--fg) 28%,transparent);
  border-radius:10px; padding:.9rem 1.05rem; margin:1.1rem 0; }
.pay-confirm input { display:block; width:100%; box-sizing:border-box; margin-top:.45rem;
  padding:.55rem .75rem; font:inherit; color:var(--fg); background:var(--bg);
  border:1px solid var(--line); border-radius:6px; }
.pay-confirm button.cta { border:0; cursor:pointer; margin-top:.6rem; }
.price { font-size:1.7rem; font-weight:650; }
.price s { color:var(--muted); font-weight:400; font-size:1.05rem; }
.toc { list-style:none; padding:0; margin:1rem 0; }
.toc > li { border:1px solid var(--line); border-radius:8px; padding:.7rem .9rem;
  margin:0 0 .6rem; background:color-mix(in srgb,var(--fg) 2.5%,transparent); }
.toc .ch { font-weight:650; }
.toc .len { color:var(--muted); font-size:.85rem; font-weight:400; }
.toc .secs { color:var(--muted); font-size:.88rem; margin:.35rem 0 0; }
.filetree { font:.78rem/1.55 ui-monospace,Menlo,monospace; white-space:pre-wrap;
  background:color-mix(in srgb,var(--fg) 6%,transparent); padding:.8rem .9rem;
  border-radius:6px; overflow-x:auto; margin:.6rem 0 0; }
.buybox { border:1px solid color-mix(in srgb,var(--stone) 35%,var(--line));
  border-radius:10px; padding:1.15rem 1.25rem; margin:1.5rem 0; background:var(--stone-soft); }
.buybox input { width:100%; font:.85em/1.5 ui-monospace,Menlo,monospace;
  padding:.5rem .6rem; border:1px solid var(--line); border-radius:6px;
  background:var(--bg); color:var(--fg); }
.buybox .cta { border:0; cursor:pointer; margin-top:.6rem; }
.sub-form { display:flex; flex-wrap:wrap; gap:.55rem; align-items:center; margin:.95rem 0 .8rem; }
.sub-form input[type=email] { flex:1 1 200px; max-width:320px; padding:.5rem .7rem;
  border:1px solid var(--line); border-radius:6px; background:var(--bg); color:var(--fg); font:inherit; }
.sub-form .cta { border:0; cursor:pointer; margin:0; }
.sub-note { flex-basis:100%; color:var(--muted); font-size:.85rem; line-height:1.5; }
#sub-msg { color:var(--fg); }
.doors { font-size:.92rem; line-height:1.6; }
.join-list { margin:.3rem 0 .2rem 1.1rem; padding:0; font-size:.95rem; line-height:1.55; }
.join-list li { margin:.35rem 0; }
.check li { margin:.35rem 0; }
table { border-collapse:collapse; width:100%; font-size:.92rem; }
.tablewrap { overflow-x:auto; max-width:100%; }
/* No image may be wider than what holds it (wake 182). An evidence photo with
   a fixed max-width:340px sat 60px indented inside its container and pushed
   /hand.html 10px past a phone viewport — a full-page screenshot cannot show
   that, which is why it survived until the sweep measured scrollWidth. */
img { max-width:100%; height:auto; }
td,th { padding:.35rem .5rem; border-bottom:1px solid var(--line); text-align:left; vertical-align:top; }
/* Storefront cards (conversion pass, D171): the three products as visual,
   comparable choices. Same palette and restraint as everything else. */
.pcards { display:grid; grid-template-columns:repeat(auto-fit,minmax(225px,1fr)); gap:1rem; margin:1rem 0; }
.pcard { border:1px solid var(--line); border-radius:10px; overflow:hidden; background:color-mix(in srgb,var(--fg) 3%,transparent); display:flex; flex-direction:column; position:relative; }
.pcard img { width:100%; display:block; aspect-ratio:1; object-fit:cover; }
.pcard .pc-body { padding:.7rem .85rem .9rem; display:flex; flex-direction:column; gap:.4rem; flex:1; }
.pcard .pc-name { font-weight:700; font-size:1.02rem; line-height:1.3; }
.pcard .pc-for { color:var(--muted); font-size:.87rem; line-height:1.45; flex:1; }
.pcard .pc-price { font-weight:700; font-size:1.05rem; }
.pcard .pc-price s { color:var(--muted); font-weight:400; font-size:.9rem; margin-left:.3rem; }
.pcard .cta { text-align:center; margin-top:.15rem; }
.pcard .pc-sub { font-size:.83rem; text-align:center; }
.badge-best { position:absolute; top:.6rem; left:.6rem; font:700 .72rem/1 ui-monospace,Menlo,monospace; letter-spacing:.05em; text-transform:uppercase; background:#3a7d44; color:#fff; border-radius:4px; padding:.3rem .5rem; }
.cover { width:100%; max-width:620px; border-radius:10px; border:1px solid var(--line); display:block; margin:.7rem 0; }
details.fine { border:1px solid var(--line); border-radius:8px; padding:.35rem .7rem; margin:.6rem 0; }
details.fine summary { cursor:pointer; color:var(--muted); font-size:.9rem; padding:.15rem 0; }
article h1 { font-size:1.55rem; margin:.2rem 0 .5rem; line-height:1.25; }
.footnav { margin:0 0 .7rem; } .footnav a { margin-right:.95rem; color:var(--muted); font-size:.85rem; }
/* ---- Storefront mode: the D32 "two intensities" made literal. A page opts
   in with frontmatter `mode: storefront`; record pages never get the class.
   Same palette, same restraint — more room (64rem shell), a real type scale,
   and explicit offer/proof/CTA structure. Bare markdown children keep a
   reading measure via the direct-child cap; only .sf-* blocks span wide. */

.storefront main.page > p, .storefront main.page > ul, .storefront main.page > ol,
.storefront main.page > blockquote, .storefront main.page > h2, .storefront main.page > h3,
.storefront main.page > h4, .storefront main.page > hr,
.storefront main.page > .pay-confirm { max-width:46rem; }
.sf-kicker { font:700 .74rem/1 ui-monospace,Menlo,monospace; letter-spacing:.14em;
  text-transform:uppercase; color:var(--stone-ink); margin:0 0 .55rem; }
.sf-hero { display:grid; grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);
  gap:2rem 3rem; align-items:center; margin:.5rem 0 1.8rem; }
.sf-hero h1 { font-size:clamp(1.7rem,4vw,2.45rem); line-height:1.14;
  letter-spacing:-.012em; margin:0 0 .8rem; }
.sf-lede { font-size:1.1rem; line-height:1.62; margin:0 0 1.15rem; }
.sf-cta-row { display:flex; flex-wrap:wrap; gap:.7rem 1.1rem; align-items:center; margin:0 0 .9rem; }
.sf-cta-row .cta { font-size:1.02rem; padding:.65rem 1.35rem; }
.sf-trust { color:var(--muted); font-size:.85rem; line-height:1.55; margin:0; }
.sf-hero-art { margin:0; }
.sf-hero-art img { display:block; width:100%; height:auto; border-radius:12px;
  border:1px solid var(--line); box-shadow:0 14px 34px rgba(0,0,0,.14); }
.sf-proof { display:grid; grid-template-columns:repeat(auto-fit,minmax(11rem,1fr));
  gap:.85rem; margin:1.6rem 0 2.4rem; }
.sf-stat { display:block; border:1px solid var(--line); border-radius:10px;
  padding:.85rem 1rem; background:color-mix(in srgb,var(--fg) 2.5%,transparent);
  text-decoration:none; color:var(--fg); }
a.sf-stat:hover { border-color:color-mix(in srgb,var(--stone) 45%,var(--line)); }
.sf-stat b { display:block; font-size:1.3rem; font-weight:700; letter-spacing:-.01em; }
.sf-stat span { color:var(--muted); font-size:.83rem; line-height:1.45; display:block; margin-top:.15rem; }
.sf-section { margin:3rem 0; }
.sf-section p.meta, .sf-section > p, .sf-section > ul { max-width:46rem; }
.sf-head { max-width:46rem; margin-bottom:1.3rem; }
.sf-head h2 { font-size:1.45rem; margin:0; }
.sf-head .sf-sub { color:var(--muted); font-size:.95rem; line-height:1.55; margin:.4rem 0 0; }
.storefront .pcards { gap:1.2rem; }
.storefront .pcard { transition:box-shadow .15s, transform .15s; }
.storefront .pcard:hover { box-shadow:0 8px 24px rgba(0,0,0,.11); transform:translateY(-2px); }
.sf-offers { display:grid; grid-template-columns:repeat(auto-fit,minmax(15rem,1fr)); gap:1rem; }
.sf-offer { border:1px solid var(--line); border-radius:10px; padding:1rem 1.1rem;
  display:flex; flex-direction:column; gap:.45rem;
  background:color-mix(in srgb,var(--fg) 2.5%,transparent); }
.sf-offer .of-top { display:flex; justify-content:space-between; gap:.6rem; align-items:baseline; }
.sf-offer .of-name { font-weight:700; line-height:1.3; }
.sf-offer .of-price { font-family:ui-monospace,Menlo,monospace; font-weight:700;
  color:var(--stone-ink); white-space:nowrap; }
.sf-offer .of-desc { color:var(--muted); font-size:.9rem; line-height:1.55; flex:1; margin:0; }
.sf-offer .of-go { font-size:.9rem; }
.sf-offer .cta { text-align:center; font-size:.92rem; }
.sf-offer { transition:box-shadow .15s, transform .15s; }
.sf-offer:hover { box-shadow:0 8px 24px rgba(0,0,0,.09); transform:translateY(-2px); }
.sf-offer .of-name a { color:inherit; text-decoration:none; border-bottom:1px solid var(--line); }
.sf-offer .of-name a:hover { border-color:currentColor; }
.tablewrap td a { color:inherit; text-decoration:none; border-bottom:1px solid var(--line); }
.tablewrap td a:hover { border-color:currentColor; }
.sf-offers { grid-template-columns:repeat(auto-fit,minmax(18rem,1fr)); }
/* ---- Service explainer pages (2026-09-09): landing-page shape. ---- */
.svc-page main.page { padding-top:.5rem; }
.svc-body { max-width:1100px; margin:0 auto; }
.svc-sec { margin:3.4rem 0; }
.svc-label { font-family:var(--mono); font-size:11px; letter-spacing:.16em; text-transform:uppercase; color:var(--muted); margin:0 0 .6rem; }
.svc-label-d { color:var(--muted-d); }
.svc-h { font-size:1.75rem; line-height:1.15; letter-spacing:-.015em; margin:0 0 1rem; font-weight:600; }
.svc-how { display:grid; grid-template-columns:repeat(3,1fr); gap:18px; }
.svc-how > div { background:var(--paper); border:1px solid var(--line); border-radius:12px; padding:20px 22px; line-height:1.5; }
.svc-how b { display:block; font-family:var(--mono); font-size:11px; letter-spacing:.14em; color:var(--stone-ink); margin-bottom:8px; font-weight:600; }
.svc-problem { display:grid; grid-template-columns:.8fr 1.6fr; gap:40px; align-items:start; background:var(--paper); border:1px solid var(--line); border-radius:14px; padding:32px 36px; }
.svc-problem p { margin:0 0 .8rem; font-size:1.06rem; line-height:1.65; }
.svc-problem p:last-child { margin:0; }
.svc-steps { list-style:none; padding:0; margin:0; display:grid; grid-template-columns:1fr 1fr; gap:16px; }
.svc-steps li { display:flex; gap:14px; background:#FBF8F2; border:1px solid var(--line); border-radius:12px; padding:18px 20px; line-height:1.55; }
.svc-steps li > div { min-width:0; }
.svc-n { font-family:var(--mono); font-size:12px; color:var(--stone-ink); font-weight:600; padding-top:.25em; min-width:2ch; }
.svc-deliver { background:var(--stone-soft); border:1px solid color-mix(in srgb,var(--stone) 45%,var(--line)); border-radius:14px; padding:32px 36px; }
.svc-deliver p { font-size:1.06rem; line-height:1.65; margin:0 0 .8rem; }
.svc-deliver p:last-child { margin:0; }
.svc-ev { display:grid; grid-template-columns:repeat(auto-fit,minmax(16rem,1fr)); gap:16px; margin-top:.4rem; }
.svc-ev-1 { grid-template-columns:1fr; }
.svc-evc p { margin:0 0 .6rem; } .svc-evc p:last-child { margin:0; }
.svc-evc { border:1px solid var(--line); border-radius:12px; padding:18px 20px; background:#FBF8F2; line-height:1.5; }
.svc-price { background:var(--ink); color:#F5F0E6; border-radius:16px; padding:40px 44px; }
.svc-price-in { display:grid; grid-template-columns:.75fr 1.5fr; gap:44px; align-items:start; }
.svc-big { font-size:2.7rem; font-weight:600; letter-spacing:-.02em; margin:.2rem 0 .5rem; line-height:1.05; color:#F5F0E6; }
.svc-pnote { color:#cfd6d1; margin:0; font-size:.95rem; line-height:1.5; }
.svc-price p { color:#cfd6d1; line-height:1.6; }
.svc-price strong { color:#F5F0E6; }
.svc-price .hp-ctas { margin:1.2rem 0 0; }
.svc-limits { border-left:3px solid var(--line); padding:.2rem 0 .2rem 1.3rem; color:var(--muted); font-size:.95rem; line-height:1.6; }
.svc-limits .svc-h { font-size:1.2rem; color:var(--fg); margin-bottom:.5rem; }
.svc-limits p { margin:0 0 .6rem; }
.svc-back { margin:2rem 0 0; }
/* services page: the grouped catalog grid that replaced the table */
.svc-grid { display:grid; gap:2.4rem; margin:1rem 0 2.4rem; }
.svc-gh { margin:0 0 .25rem; font-size:1.3rem; }
.svc-gsub { color:var(--muted); margin:0 0 1rem; font-size:.95rem; }
.svc-cards { display:grid; grid-template-columns:repeat(auto-fit,minmax(17rem,1fr)); gap:14px; }
.svc-card { display:flex; flex-direction:column; gap:.45rem; text-decoration:none; color:inherit; border:1px solid var(--line); border-radius:12px; padding:18px 20px; background:#FBF8F2; transition:box-shadow .15s, transform .15s; }
.svc-card:hover { box-shadow:0 8px 24px rgba(0,0,0,.09); transform:translateY(-2px); }
.svc-cname { font-weight:700; font-size:1.05rem; line-height:1.3; }
.svc-cblurb { color:var(--muted); font-size:.9rem; line-height:1.5; flex:1; }
.svc-cfoot { display:flex; justify-content:space-between; align-items:baseline; gap:.6rem; margin-top:.3rem; }
.svc-cprice { font-family:var(--mono); font-size:.9rem; color:var(--stone-ink); font-weight:600; }
.svc-carrow { font-size:.88rem; color:var(--stone-ink); }
/* Contrast pass (2026-09-09) — TOKENISED so it holds in BOTH colour
   schemes (the first cut used fixed hex values and went dark-on-dark for
   dark-mode readers). Light: dark ink inside cards, deep-teal accents,
   solid dark-teal buttons on light ground. Dark: the same roles mapped to
   the dark palette. The dark hero and the dark price band are fixed-dark
   in both modes and keep the light accent. */
:root { --card-bg:#FFFDF9; --card-ink:#2a2721; --card-line:#8f8470; --accent-ink:#0b5c50; --btn-bg:#0b5c50; --btn-fg:#ffffff; --soft-ink:#4a4539; }
@media (prefers-color-scheme: dark) {
  :root { --card-bg:#151d1b; --card-ink:#E4DED0; --card-line:#3a4844; --accent-ink:#7DE3D7; --btn-bg:#7DE3D7; --btn-fg:#08110f; --soft-ink:#b9b1a0; }
}
body.storefront main.page a { color:var(--accent-ink); border-bottom:1px solid color-mix(in srgb,var(--accent-ink) 45%,transparent); }
body.storefront main.page a:hover { border-bottom-color:var(--accent-ink); }
body.storefront .sf-offer, body.storefront .svc-card, body.storefront .svc-evc, body.storefront .svc-steps li { background:var(--card-bg); border-color:var(--card-line); }
body.storefront .of-desc, body.storefront .of-go, body.storefront .svc-cblurb, body.storefront .pc-for,
body.storefront .svc-steps li, body.storefront .svc-evc, body.storefront .svc-problem p, body.storefront .svc-deliver p,
body.storefront .svc-how > div { color:var(--card-ink); }
body.storefront .svc-gsub, body.storefront .svc-limits, body.storefront .svc-limits p { color:var(--soft-ink); }
body.storefront .svc-label { color:var(--accent-ink); font-size:12.5px; font-weight:700; letter-spacing:.14em; }
body.storefront .svc-price .svc-label { color:#7DE3D7; }
body.storefront .svc-cprice, body.storefront .svc-carrow, body.storefront .of-price, body.storefront .svc-n, body.storefront .svc-how b { color:var(--accent-ink); }
body.storefront .svc-cname, body.storefront .of-name, body.storefront h2, body.storefront h3, body.storefront .svc-h, body.storefront .svc-gh { color:var(--fg); }
body.storefront main.page .cta { background:var(--btn-bg); color:var(--btn-fg); border:1px solid var(--btn-bg); }
body.storefront main.page .cta:hover { filter:brightness(.92); color:var(--btn-fg); }
body.storefront main.page .cta.ghost { background:transparent; color:var(--accent-ink); border-color:var(--accent-ink); }
body.storefront main.page .svc-price .cta { background:var(--stone); color:var(--cta-fg); border-color:var(--stone); }
body.storefront main.page .svc-price .cta.ghost { background:transparent; color:#F5F0E6; border:1px solid rgba(255,255,255,.45); }
.art .ahead, .art .afoot, .art .akick, .art .asub { color:#2a2721; }
.art .ahead .ok { color:#0b5c50; font-weight:700; }
.art .chk { color:#101716; }
.art h3, .art .abody h3, .abody .ah3 { color:#101716; }  /* the panel is fixed-light in both schemes */
.abody .ah3 { font-size:1.25rem; font-weight:600; line-height:1.25; margin:0 0 .35rem; }
.art a.chk { text-decoration:none; color:#101716; }
.art a.chk:hover { color:#0b5c50; }
.art a.chk code { color:#0b5c50; font-weight:600; }
a.hp-card { text-decoration:none; color:inherit; transition:box-shadow .15s, transform .15s; }
a.hp-card:hover { box-shadow:0 8px 24px rgba(0,0,0,.12); transform:translateY(-2px); }
.hp-card .more { color:var(--stone-ink); font-size:14px; font-weight:600; }
.hp-card.hp-svc h3 { color:#101716; }
.hp-card .cmeta div { color:#101716; }
.hp-card .more { color:#0b5c50; }
.hp-card p { color:#4c4a41; }
.pay-option .note, .note { color:var(--soft-ink); }
.meta code, .toc .len code, .len code { color:var(--soft-ink); }
.hp .eyebrow { color:#F5F0E6; font-weight:500; }
.hp-lede { color:#E9E3D6; }
.hp .disclose { color:#cfd6d1; }
.hp-proof span { color:var(--band-fg2); }
.topstrip { color:#DCD5C6; }
@media (max-width:940px){ .svc-problem, .svc-price-in { grid-template-columns:1fr; gap:18px; } .svc-steps, .svc-how { grid-template-columns:1fr; } }
@media (max-width:620px){ .svc-price { padding:26px 22px; } .svc-big { font-size:2.1rem; } .svc-h { font-size:1.45rem; } .svc-problem, .svc-deliver { padding:22px 20px; } .svc-sec { margin:2.4rem 0; } }
.sf-final { display:flex; flex-wrap:wrap; gap:1rem 2rem; align-items:center;
  justify-content:space-between; border:1px solid color-mix(in srgb,var(--stone) 35%,var(--line));
  background:var(--stone-soft); border-radius:12px; padding:1.5rem 1.7rem; margin:3rem 0 1.5rem; }
.sf-final .fl-line { font-size:1.12rem; font-weight:700; margin:0; }
.sf-final .fl-sub { color:var(--muted); font-size:.88rem; margin:.25rem 0 0; }
@media (max-width:760px) {
  .sf-hero { grid-template-columns:1fr; gap:1.5rem; }
  .sf-hero-art { max-width:21rem; }
}
